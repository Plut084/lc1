# Linux x86_64 host toolchain and runtime environment.
#
#   conan install . -pr:h profiles/linux -pr:b default --build=missing -s build_type=Debug
#
# Keep this independent of the user's default profile: inherited options such as
# *:shared=False would override conanfile.py's shared Wayland dependency defaults.
# Project dependency options are defined in conanfile.py.

[settings]
arch=x86_64
os=Linux
build_type=Release
compiler=clang
compiler.version=22
compiler.cstd=11
compiler.cppstd=23
compiler.libcxx=libstdc++

[conf]
tools.build:compiler_executables={"c": "clang", "cpp": "clang++"}
tools.cmake.cmaketoolchain:generator=Ninja

[buildenv]
CC=clang
CXX=clang++

[runenv]
# The conan-built libxkbcommon has no compiled-in XLOCALEDIR default. Use the
# system's compose data so compose/dead-key input works without locale warnings.
# The generated conanrun.sh exports this when running the Linux build.
XLOCALEDIR=/usr/share/X11/locale
