# Project host profile for Windows, cross-compiled from Linux with MinGW-w64.
#
#   conan install . -pr:h profiles/mingw64 -pr:b default --build=missing -s build_type=Release
#   cmake --preset windows-x86_64-release && cmake --build --preset windows-x86_64-release
#
# or, in one step:  make build PLATFORM=windows-x86_64 BUILD_TYPE=Release
#
# NOT include(default): the default profile describes this Linux machine, and this
# profile describes the Windows binaries it produces. The two are different halves of
# the same install -- `-pr:b default` is the build context, this is the host context.
# Conan sees os differ between them and sets CMAKE_SYSTEM_NAME=Windows in the
# toolchain, which is what switches CMake into cross-compiling mode.
#
# WHY THIS FILE IS IN THE REPO
# It used to live only in ~/.conan2/profiles/, which the Makefile then referred to by
# name -- so a fresh clone had a `-windows` target that no other machine could run.
# A profile is part of the build story, so it is committed with it.
#
# The compiler is gcc (MinGW-w64), with target-triple-prefixed executables so
# conan never picks up the host gcc. Project dependency defaults, including
# static linkage and platform windowing options, live in conanfile.py.
#
# The Vulkan loader is NOT a dependency here either -- see the bottom of conanfile.py.
# On Windows vulkan-1.dll is the system loader, dlopened by vk::raii::Context.

[settings]
arch=x86_64
os=Windows
compiler=gcc
compiler.version=16
compiler.cppstd=23
compiler.libcxx=libstdc++

[options]
# Environment-specific opt-out: avoid cross-compiling the large validation-layer
# package. Wine runs the application with LC1_NO_VALIDATION=1; override this option
# when provisioning validation layers for a Windows Debug environment.
lc1/*:with_validation_layers=False

[conf]
# The rc entry is not optional: CMake passes .rc files through windres on Windows, and
# the unprefixed name does not exist on a Linux host.
tools.build:compiler_executables={"c": "x86_64-w64-mingw32-gcc", "cpp": "x86_64-w64-mingw32-g++", "rc": "x86_64-w64-mingw32-windres"}
# Ninja keeps this a single-config generator, which is what the pinned
# build/<platform>/<build_type> layout in conanfile.py assumes. It also means the
# Windows tree is configured and built by the same commands as the Linux one.
tools.cmake.cmaketoolchain:generator=Ninja

[buildenv]
CC=x86_64-w64-mingw32-gcc
CXX=x86_64-w64-mingw32-g++
WINDRES=x86_64-w64-mingw32-windres
RC=x86_64-w64-mingw32-windres
