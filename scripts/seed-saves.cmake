if(NOT DEFINED SOURCE_DIR OR NOT DEFINED DESTINATION_DIR)
    message(FATAL_ERROR "SOURCE_DIR and DESTINATION_DIR are required")
endif()

file(GLOB slots RELATIVE "${SOURCE_DIR}" "${SOURCE_DIR}/*")
foreach(slot IN LISTS slots)
    if(NOT IS_DIRECTORY "${SOURCE_DIR}/${slot}")
        continue()
    endif()
    foreach(name factions equipments weapons parties characters session)
        set(source "${SOURCE_DIR}/${slot}/${name}.yaml")
        set(destination "${DESTINATION_DIR}/${slot}/${name}.yaml")
        if(EXISTS "${source}" AND NOT EXISTS "${destination}")
            file(MAKE_DIRECTORY "${DESTINATION_DIR}/${slot}")
            configure_file("${source}" "${destination}" COPYONLY)
        endif()
    endforeach()
endforeach()
